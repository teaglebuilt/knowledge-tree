.DS_Store
**/.DS_Store

# Local Claude Code settings
.claude/settings.local.json

# Vector store / DB artifacts
*.duckdb
*.lance
.lancedb/

__pycache__*
.venv
*.wal
# Source binaries (books/papers) — kept locally & in object storage, never in git.
# Only the extracted markdown + sources/MANIFEST.md carry provenance into the repo.
*.epub
*.pdf
# ...but keep the sources/ folder structure + manifest tracked so provenance is versioned.
!sources/**/.gitkeep
!sources/MANIFEST.md
.envrc
# transient expanded sops config (kb.secrets._sops)
.sops-*.yaml
